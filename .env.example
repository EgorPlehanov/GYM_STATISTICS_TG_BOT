# Application
APP_ENV=dev
APP_NAME=Gym Statistics
MAIN_ADMIN_ID=123456789

# Telegram
TG_BOT_TOKEN=0000000000:replace-with-real-token
TG_BOT_USERNAME=your_bot_username

# PostgreSQL
POSTGRES_USER=gym
POSTGRES_PASSWORD=gym
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=gym_statistics

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api:8000
BOT_API_BASE_URL=http://api:8000
INTERNAL_API_TOKEN=replace-with-long-random-internal-token
BACKEND_CORS_ORIGINS=http://localhost:5173

# Web
WEB_APP_URL=http://localhost:5173

# Sessions and cookies
SESSION_SECRET_KEY=replace-with-long-random-secret
SESSION_COOKIE_NAME=gym_statistics_session
SESSION_TTL_SECONDS=2592000
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
